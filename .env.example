# Server-only Guyu access settings. Never expose these through VITE_ variables.
GUYU_ACCESS_ANSWER=
GUYU_SESSION_SECRET=
GUYU_MEDIA_ORIGIN=https://duomei-media-storage.colorsugar.workers.dev
VITE_DUOMEI_MEDIA_ORIGIN=https://duomei-media-storage.colorsugar.workers.dev
GUYU_MEDIA_SIGNING_SECRET=

# Optional: 早报同步微信公众号草稿（scripts/zaobao-wechat-draft.mjs）。只放本机/Secrets，别提交真值。
# 公众平台须把运行脚本的出口 IP 加入白名单。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 可复用已有封面永久素材；没有就用 --upload-images 上传首图。
WECHAT_THUMB_MEDIA_ID=
