{
  "name": "duomei-site-full",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "22.17.1",
  "redirects": [
    {
      "source": "/dgy-build/*",
      "destination": "/honglou/dgy-build/:splat",
      "statusCode": 302
    },
    {
      "source": "/dgy/*",
      "destination": "/honglou/dgy/:splat",
      "statusCode": 302
    },
    {
      "source": "/dgy-assets/*",
      "destination": "/honglou/dgy-assets/:splat",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/yunyou/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/xiaoyuan-scene/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/honglou/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/honglou/dgy-assets/cutscene/ch17/ch17.m3u8",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.apple.mpegurl" }
      ]
    },
    {
      "source": "/atlas/v6/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/atlas/chaoji/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "cloudFunctions": {
    "regions": {
      "overseas": ["ap-singapore"]
    },
    "maxDuration": 30
  }
}
