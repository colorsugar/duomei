{
  "name": "duomei-site-full",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "22.17.1",
  "redirects": [
    { "source": "/honglou/dgy-assets/cutscene/*", "destination": "https://pub-a5518eab59124044896bde848cb28d8b.r2.dev/honglou/dgy-assets/cutscene/:splat", "statusCode": 302 },
    { "source": "/honglou/dgy-assets/codex/*", "destination": "https://pub-a5518eab59124044896bde848cb28d8b.r2.dev/honglou/dgy-assets/codex/:splat", "statusCode": 302 },
    { "source": "/honglou/dgy-assets/album/*", "destination": "https://pub-a5518eab59124044896bde848cb28d8b.r2.dev/honglou/dgy-assets/album/:splat", "statusCode": 302 },
    { "source": "/honglou/dgy-assets/huace/img/*", "destination": "https://pub-a5518eab59124044896bde848cb28d8b.r2.dev/honglou/dgy-assets/huace/img/:splat", "statusCode": 302 }
  ],
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/yunyou/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/xiaoyuan-scene/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/honglou/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/atlas/v6/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/atlas/chaoji/*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "cloudFunctions": {
    "regions": {
      "overseas": ["ap-singapore"]
    },
    "maxDuration": 30
  }
}
