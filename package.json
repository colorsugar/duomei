{
  "name": "duomei-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DUOMEI 多美小记，记录旅途中的风景、生活片段、旅行照片和心情文字。",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:server && tsc -b && vite build",
    "typecheck": "tsc -b",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:guyu": "node --experimental-strip-types --test server/guyuSession.test.ts server/guyuRateLimit.test.ts server/guyuBooks.test.ts server/guyuEdgeOneAdapter.test.mjs",
    "lint": "tsc -b",
    "preview": "vite preview",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1"
  },
  "dependencies": {
    "@edgeone/pages-blob": "0.0.16",
    "@supabase/supabase-js": "^2.110.0",
    "@vitejs/plugin-react": "^5.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "page-flip": "2.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-pageflip": "2.0.3",
    "react-router-dom": "^7.18.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
