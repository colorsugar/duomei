  "分镜": [
    {
      "类": "画",
      "幅": "dgy-assets/album/haitang/02.webp",
      "旁白": "李纨说自己不会作诗，掌坛却当仁不让。",
      "旁白2": "李纨一身素衣进门，开口便自荐掌坛。守节的人难得高兴一回，这一回她当仁不让。",
      "原文": "雅的緊！要起詩社，我自薦我掌壇。",
      "回": 37,
      "画面": "秋爽斋屋里，宝玉、黛玉、宝钗、迎春、惜春已坐下，探春笑着招呼；李纨一身素衣掀帘进门，满面笑意，抬手说话。窗外梧桐、芭蕉。",
      "时长": 8
    },
    {
      "类": "画",
      "幅": "dgy-assets/album/haitang/03.webp",
      "旁白": "稻香老农，想来是取自她住的稻香村。",
      "旁白2": "稻香老农，一个号把青年守寡的人说成了种地的老人家。她先占了，旁人也不好争。",
      "原文": "李紈道：「極是，何不大家起個別號，彼此稱呼則雅。我是定了『稻香老農』，再無人占的。」",
      "回": 37,
      "画面": "同一屋里，众人围坐，李纨笑着说话；探春托腮在想自己的号，宝玉在旁出主意。",
      "时长": 9
    },
    {
      "类": "画",
      "幅": "dgy-assets/album/haitang/04.webp",
      "旁白": "黛玉还接一句“快做了鹿脯来”。探春当场回敬，给她起了“潇湘妃子”的号。",
      "旁白2": "探春才说爱芭蕉，黛玉就要把这只鹿「燉了脯子吃酒」。笑声未了，探春的回礼已备下了。",
      "原文": "古人曾云『蕉葉覆鹿』。他自稱『蕉下客』，可不是一隻鹿了？",
      "回": 37,
      "画面": "窗外一丛芭蕉。探春刚说完“蕉下客”，黛玉掩口笑着指她打趣，众人哄笑，探春佯嗔要回嘴。",
      "时长": 10
    },
    {
      "类": "白",
      "说": "baoyu",
      "表情": "愁",
      "原文": "了不得！香只剩了一寸了，我才有了四句。",
      "白话": "题是咏白海棠，限「门、盆、魂、痕、昏」五个韵，点一支梦甜香为限。探春、宝钗都写好了，宝玉还在廊下踱：香只剩一寸，才有四句！",
      "旁白2": "梦甜香只三寸来长，探春先有了，宝钗也有了。宝玉背着手在回廊上踱来踱去，越催越慌。",
      "回": 37,
      "时长": 7
    },
    {
      "类": "白",
      "说": "liwan",
      "表情": "笑",
      "原文": "我們要看詩了，若看完了還不交卷是必罰的。",
      "白话": "李纨说：要看诗了，看完还不交卷的要罚。",
      "旁白2": "梦甜香只有三寸来长，灯草粗细，烧得极快。李纨看着香催卷，不作诗的人最会看时辰。",
      "回": 37,
      "时长": 8
    },
    {
      "类": "诗",
      "作品": "haitang-tanchun",
      "说": "tanchun",
      "表情": "笑",
      "前": "於是先看探春的稿上寫道是",
      "回": 37
    },
    {
      "类": "诗",
      "作品": "haitang-baochai",
      "说": "baochai",
      "表情": "平",
      "前": "次看寶釵的是",
      "回": 37
    },
    {
      "类": "白",
      "说": "liwan",
      "表情": "笑",
      "原文": "到底是蘅蕪君。",
      "白话": "李纨看了宝钗的，笑着说：到底是蘅芜君。",
      "旁白2": "李纨看了宝钗的诗，只说一句。一个「到底」，名次已定了七分。",
      "回": 37,
      "时长": 5
    },
    {
      "类": "诗",
      "作品": "haitang-baoyu",
      "说": "baoyu",
      "表情": "愁",
      "前": "說著又看寶玉的，道是",
      "回": 37
    },
    {
      "类": "画",
      "幅": "dgy-assets/album/haitang/05.webp",
      "旁白": "众人看了都叫好，说她“果然比别人又是一样心肠”。",
      "旁白2": "别人的都看过了，黛玉才提笔，一挥而就掷给众人。梨蕊梅花，偷来借得，白海棠写成了她自己。",
      "原文": "偷來梨蕊三分白，借得梅花一縷魂。",
      "回": 37,
      "画面": "案上诗笺。黛玉提笔一挥而就，把诗掷给众人；李纨等人凑着看，宝玉拍手喝彩，黛玉神情淡淡。",
      "时长": 9
    },
    {
      "类": "诗",
      "作品": "haitang-daiyu",
      "说": "daiyu",
      "表情": "平",
      "前": "提筆一揮而就，擲與眾人。",
      "回": 37
    },
    {
      "类": "画",
      "幅": "dgy-assets/album/haitang/06.webp",
      "旁白": "第一给了宝钗，第二是黛玉，宝玉压尾——他还想争，被李纨一句“再有多说者必罚”堵了回去。",
      "旁白2": "宝钗含笑，黛玉侧脸，宝玉张口欲争。名次还没念完，三人的分寸先摆在脸上。",
      "原文": "李紈道：「若論風流別致，自是這首，若論含蓄渾厚，終讓蘅稿。」探春道：「這評的有理，瀟湘妃子當居第二。」",
      "回": 37,
      "画面": "李纨坐在上首执笺评诗，探春在旁点头称是；宝钗端坐含笑不语，黛玉微微侧脸，宝玉张口想争。",
      "时长": 10
    },
    {
      "类": "评",
      "说": "liwan",
      "表情": "笑",
      "原文": "若論風流別致，自是這首，若論含蓄渾厚，終讓蘅稿。",
      "白话": "李纨评：要论风流别致，数黛玉这首；要论含蓄浑厚，还得让宝钗。宝钗第一，黛玉第二。",
      "旁白2": "李纨持笺定评，两句话各给一头。风流归了潇湘，第一归了蘅芜，长嫂的秤到底偏向稳重。",
      "回": 37,
      "时长": 9
    },
    {
      "类": "白",
      "说": "liwan",
      "表情": "笑",
      "原文": "怡紅公子是壓尾，你服不服？",
      "白话": "李纨问：怡红公子压尾，你服不服？",
      "旁白2": "评完两位姑娘，李纨转身打趣宝玉。压尾的偏是满座唯一的男子，众人都笑。",
      "回": 37,
      "时长": 5
    },
    {
      "类": "白",
      "说": "baoyu",
      "表情": "笑",
      "原文": "我的那首原不好了，這評的最公。",
      "白话": "宝玉说：我那首本来就不好，评得最公道。（转头又说蘅、潇二首还要斟酌，被李纨一句「再有多说者必罚」堵了回去。）",
      "旁白2": "宝玉自认压尾，服得爽快，转头又说蘅潇两首还要斟酌。他不服的，从来不是自己的名次。",
      "回": 37,
      "时长": 8
    }
  ],
